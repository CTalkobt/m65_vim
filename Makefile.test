# Makefile for unit tests

TARGET := bin/vim_test
CC := gcc

# Source files
TEST_SRCS := test/test_main.c test/test_itostr.c test/test_line.c test/test_line_edge.c test/test_keycodes.c test/test_undo.c test/test_cmd.c test/test_cmd_exec.c test/test_cmd_mode.c test/test_cmd_colon.c test/test_cmd_nav.c test/test_editor.c test/platform_stub.c
CORE_SRCS := src/core/itostr.c src/core/line.c src/core/lib/keycodes.c src/core/undo.c src/core/cmd.c src/core/editor.c src/core/render.c src/core/debug.c
SRCS := $(TEST_SRCS) $(CORE_SRCS)

OBJS := $(SRCS:.c=.o)

CFLAGS := -g -Wall -Wextra -Isrc/core -Isrc/core/lib -Isrc/platform -Isrc -Itest -D__TEST__ -DDEBUG_ON \
	-DPLATFORM_FILENAME_COL=20 '-DPLATFORM_MODE_NORMAL_STR="-- Normal --"' '-DPLATFORM_MODE_INSERT_STR="-- Insert --"'
LDFLAGS :=

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p bin
	$(CC) -o $(TARGET) $(OBJS) $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all run clean
