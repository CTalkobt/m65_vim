# Makefile for the C64 platform

TARGET := bin/vim_c64
BUILD_DIR := build/c64

# Source files
CORE_SRCS := $(wildcard src/core/*.c) $(wildcard src/core/lib/*.c)
PLATFORM_SRCS := src/platform/c64/platform_c64.c src/platform/cbm/kernal.c
ASSEMBLY_SRCS := src/platform/cbm/kernal_calypsi.s
SRCS := $(CORE_SRCS) $(PLATFORM_SRCS)

OBJS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(SRCS)) $(patsubst %.s,$(BUILD_DIR)/%.o,$(ASSEMBLY_SRCS))

# --- Toolchain Configuration ---
CC := cc6502
AS := as6502
LD := ln6502
CFLAGS := -g -Isrc -Isrc/core -Isrc/platform -Isrc/platform/cbm -D__C64__ -D__CBM__ -D__CALYPSI__ -DDEBUG_ON
CFLAGS += --core=6502 --target=C64 --char-is-unsigned
ASFLAGS := --core=6502 --target=C64
LDFLAGS := --target=C64 c64-plain.scm --output-format prg --load-address 0x0801 --cstack-size 0x0700 --heap-size 0x0100

# Default target
all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p bin
	$(LD) $(OBJS) -o $(TARGET) $(LDFLAGS)
	@echo "Build complete: $(TARGET)"

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(@D)
	$(AS) $(ASFLAGS) $< -o $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

.PHONY: all clean
